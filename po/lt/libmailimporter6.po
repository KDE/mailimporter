#: mailimporter/filters/filterkmail_maildir.cpp:27
#, kde-format
msgid "Import KMail Maildirs and Folder Structure"
msgstr "Importuoti KMail el. laiškų katalogus ir aplankų struktūrą"

#: mailimporter/filters/filterkmail_maildir.cpp:29
#, kde-format
msgid ""
"<p><b>KMail import filter</b></p><p>Select the base directory of the KMail "
"mailfolder you want to import.</p><p><b>Note:</b> Never select your current "
"local KMail maildir (usually ~/Mail or ~/.kde/share/apps/kmail/mail ): in "
"this case, ImportWizard may become stuck in a continuous loop. </p><p>This "
"filter does not import KMail mailfolders with mbox files.</p><p>Since it is "
"possible to recreate the folder structure, the folders will be stored under: "
"\"KMail-Import\" in your local folder.</p>"
msgstr ""
"<p><b>KMail importаvimo filtras</b></p><p>Pasirinkite pagrindinį KMail pašto "
"aplanką, kurį norite importuoti.</p><p><b>Pastaba:</b> Nesirinkite "
"dabartinio vietinio KMail pašto aplanko (įprastai ~/Mail ar ~/.kde/share/"
"apps/kmail/mail ): tokiu atveju, importavimo vediklis gali užstrigti "
"nenutrūkstančiame cikle. </p><p>Šis filtras neimportuoja KMail pašto "
"aplankų, kuriuose yra mbox failai.</p><p>Kadangi įmanoma atkurti aplankų "
"struktūrą, aplankai bus sudėti jūsų vietiniame aplanke į: „KMail-Import“.</p>"

