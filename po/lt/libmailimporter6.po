#: mailimporter/filters/filterseamonkey.cpp:16
#, kde-format
msgid "Import SeaMonkey Mails and Folder Structure"
msgstr "Importuoti SeaMonkey el. laiškus ir aplankų struktūrą"

#: mailimporter/filters/filterseamonkey.cpp:19
#, kde-format
msgid ""
"<p><b>SeaMonkey import filter</b></p><p>Select your base SeaMonkey "
"mailfolder (usually ~/.icedove/*.default/Mail/Local Folders/).</p><p><b>Note:"
"</b> Never choose a Folder which <u>does not</u> contain mbox-files (for "
"example, a maildir): if you do, you will get many new folders.</p><p>Since "
"it is possible to recreate the folder structure, the folders will be stored "
"under: \"SeaMonkey-Import\".</p>"
msgstr ""
"<p><b>SeaMonkey importavimo filtras</b></p><p>Pasirinkite pagrindinį "
"SeaMonkey pašto aplanką (įprastai ~/.icedove/*.default/Mail/Local Folders/)."
"</p><p><b>Pastaba:</b> Nesirinkite aplanko, kuriame <u>nėra</u> mbox failų "
"(pvz., maildir): jei visgi taip padarysite, bus sukurta daug naujų aplankų.</"
"p><p>Kadangi įmanoma atkurti aplankų struktūrą, aplankai bus sudėti į: "
"„SeaMonkey-Import“.</p>"

#: mailimporter/filters/filtersylpheed.cpp:29
#, kde-format
msgid "Import Sylpheed Maildirs and Folder Structure"
msgstr "Importuoti Sylpheed el. laiškų katalogus ir aplankų struktūrą"

#: mailimporter/filters/filtersylpheed.cpp:31
#, kde-format
msgid ""
"<p><b>Sylpheed import filter</b></p><p>Select the base directory of the "
"Sylpheed mailfolder you want to import (usually: ~/Mail ).</p><p>Since it is "
"possible to recreate the folder structure, the folders will be stored under: "
"\"Sylpheed-Import\" in your local folder.</p><p>This filter also recreates "
"the status of message, e.g. new or forwarded.</p>"
msgstr ""
"<p><b>Sylpheed importavimo filtras</b></p><p>Pasirinkite pagrindinį Sylpheed "
"pašto aplanką, kurį norite importuoti (įprastai: ~/Mail )</p><p>Kadangi "
"įmanoma atkurti aplankų struktūrą, aplankai bus sudėti į: „Sylpheed-"
"importavimas“.</p><p>Šis filtras taip pat atkurs laiškų būsenas, pvz., "
"„Naujas“ ar „Persiųstas“.</p>"

