#, kde-format
msgid "Import Outlook Express Emails"
msgstr "Importuoti Outlook Express el. laiškus"

#: mailimporter/filters/filteroe.cpp:35
#, kde-format
msgid "Laurence Anderson <br>( Filter enhanced by Danny Kukawka )</p>"
msgstr "Laurence Anderson <br>( Danny Kukawka patobulintas filtras )</p>"

#: mailimporter/filters/filteroe.cpp:36
#, kde-format
msgid ""
"<p><b>Outlook Express 4/5/6 import filter</b></p><p>You will need to locate "
"the folder where the mailbox has been stored by searching for .dbx or .mbx "
"files under <ul><li><i>C:\\Windows\\Application Data</i> in Windows 9x</"
"li><li><i>Documents and Settings</i> in Windows 2000 or later</li></ul></"
"p><p><b>Note:</b> Since it is possible to recreate the folder structure, the "
"folders from Outlook Express 5 and 6 will be stored under: \"OE-Import\" in "
"your local folder.</p>"
msgstr ""
"<p><b>Outlook Express 4/5/6 importаvimo filtras</b></p><p>Jums reikės "
"nustatyti aplanko, kuriame laikoma pašto dėžutė, vietą, atliekant paiešką ir "
"surandant .dbx ar .mbx failus aplanke <ul><li><i>C:\\Windows\\Application "
"Data</i> (jei naudojate „Windows 9x“) arba</li><li><i>Documents and "
"Settings</i> (jei naudojate „Windows 2000“ ar naujesnę versiją).</li></ul></"
"p><p><b>Pastaba:</b> Kadangi įmanoma atkurti aplankų struktūrą, aplankai iš "
"Outlook Express 5 (ar 6) jūsų vietiniame aplanke bus sudėti į: „OE-Import“.</"
"p>"

