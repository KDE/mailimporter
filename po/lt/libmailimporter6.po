#: mailimporter/filters/filterthebat.cpp:29
#, kde-format
msgid "Import The Bat! Mails and Folder Structure"
msgstr "Importuoti The Bat! el. laiškus ir aplankų struktūrą"

#: mailimporter/filters/filterthebat.cpp:31
#, kde-format
msgid ""
"<p><b>The Bat! import filter</b></p><p>Select the base directory of the 'The "
"Bat!' local mailfolder you want to import.</p><p><b>Note:</b> This filter "
"imports the *.tbb-files from 'The Bat!' local folder, e.g. from POP "
"accounts, and not from IMAP/DIMAP accounts.</p><p>Since it is possible to "
"recreate the folder structure, the folders will be stored under: \"TheBat-"
"Import\" in your local account.</p>"
msgstr ""
"<p><b>The Bat! importаvimo filtras</b></p><p>Pasirinkite pagrindinį vietinį "
"„The Bat!“ pašto katalogą, kurį norite importuoti.</p><p><b>Pastaba:</b> Šis "
"filtras importuoja *.tbb failus iš „The Bat!“ vietinio aplanko, pvz., iš POP "
"paskyrų, bet ne iš IMAP/DIMAP paskyrų.</p><p>Kadangi įmanoma atkurti aplankų "
"struktūrą, aplankai bus sudėti jūsų vietinėje paskyroje į: „TheBat-"
"importavimas“.</p>"

#: mailimporter/filters/filterthebat.cpp:204
#, kde-format
msgctxt "Define folder where we will import thebat mails"
msgid "TheBat-Import"
msgstr "TheBat-importavimas"

#: mailimporter/filters/filterthunderbird.cpp:26
#, kde-format
msgid "Import Thunderbird/Mozilla Local Mails and Folder Structure"
msgstr ""
"Importuoti Thunderbird/Mozilla vietinius el. laiškus ir aplankų struktūrą"

#: mailimporter/filters/filterthunderbird.cpp:28
#, kde-format
msgid ""
"<p><b>Thunderbird/Mozilla import filter</b></p><p>Select your base "
"Thunderbird/Mozilla mailfolder (usually ~/.thunderbird/*.default/Mail/Local "
"Folders/).</p><p><b>Note:</b> Never choose a Folder which <u>does not</u> "
"contain mbox-files (for example, a maildir): if you do, you will get many "
"new folders.</p><p>Since it is possible to recreate the folder structure, "
"the folders will be stored under: \"Thunderbird-Import\".</p>"
msgstr ""
"<p><b>Thunderbird/Mozilla importavimo filtras</b></p><p>Pasirinkite "
"pagrindinį Thunderbird/Mozilla pašto aplanką (įprastai tai yra ~/."
"thunderbird/*.default/Mail/Local Folders/).</p><p><b>Pastaba:</b> "
"Nesirinkite aplanko, kuriame <u>nėra</u> mbox failų (pvz., maildir): jei "
"visgi taip padarysite, bus sukurta daug naujų aplankų.</p><p>Kadangi įmanoma "
"atkurti aplankų struktūrą, aplankai bus sudėti į: „Thunderbird-Import“.</p>"

